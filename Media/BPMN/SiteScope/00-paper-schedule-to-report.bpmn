<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_P2" targetNamespace="https://sitescope.smart-crg.com/bpmn" exporter="SiteScope BPMN generator" exporterVersion="1.0">
<bpmn:collaboration id="Collab_P2"><bpmn:participant id="Pool_P2" name="SiteScope schedule-to-report workflow (paper Fig. 2)" processRef="Process_P2"/>
</bpmn:collaboration>
<bpmn:process id="Process_P2" isExecutable="false">
<bpmn:laneSet id="LaneSet_P2">
<bpmn:lane id="Lane_man" name="Manual workflow"><bpmn:flowNodeRef>ms</bpmn:flowNodeRef><bpmn:flowNodeRef>sm1</bpmn:flowNodeRef><bpmn:flowNodeRef>m1</bpmn:flowNodeRef><bpmn:flowNodeRef>m2</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_plat" name="User / SiteScope platform"><bpmn:flowNodeRef>ps</bpmn:flowNodeRef><bpmn:flowNodeRef>sr</bpmn:flowNodeRef><bpmn:flowNodeRef>r1</bpmn:flowNodeRef><bpmn:flowNodeRef>occ</bpmn:flowNodeRef><bpmn:flowNodeRef>mk</bpmn:flowNodeRef><bpmn:flowNodeRef>ev</bpmn:flowNodeRef><bpmn:flowNodeRef>ing</bpmn:flowNodeRef><bpmn:flowNodeRef>rev</bpmn:flowNodeRef><bpmn:flowNodeRef>gen</bpmn:flowNodeRef><bpmn:flowNodeRef>pub</bpmn:flowNodeRef><bpmn:flowNodeRef>end</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_rob" name="Robot system"><bpmn:flowNodeRef>r2</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="ms" name="Start"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
<bpmn:manualTask id="sm1" name="S-M1: Define route"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:manualTask>
<bpmn:manualTask id="m1" name="M1: Prepare camera"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:manualTask>
<bpmn:manualTask id="m2" name="M2: Capture and upload evidence"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:manualTask>
<bpmn:startEvent id="ps" name="Start"><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:startEvent>
<bpmn:userTask id="sr" name="S-R1–S-R5: Configure robotic workflow"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:userTask>
<bpmn:manualTask id="r1" name="R1: Start robot"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:manualTask>
<bpmn:intermediateCatchEvent id="occ" name="Scheduled occurrence"><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing><bpmn:timerEventDefinition id="TED_occ"/></bpmn:intermediateCatchEvent>
<bpmn:serviceTask id="mk" name="Create mission"><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="r2" name="R2: Claim mission, navigate, capture, upload, return to H"><bpmn:incoming>Flow_9</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="ev" name="Evidence available"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="ing" name="Ingest and store with provenance"><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_12</bpmn:outgoing></bpmn:serviceTask>
<bpmn:userTask id="rev" name="Review and annotate"><bpmn:incoming>Flow_12</bpmn:incoming><bpmn:outgoing>Flow_13</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="gen" name="Generate PDF"><bpmn:incoming>Flow_13</bpmn:incoming><bpmn:outgoing>Flow_14</bpmn:outgoing></bpmn:serviceTask>
<bpmn:userTask id="pub" name="Verify and publish"><bpmn:incoming>Flow_14</bpmn:incoming><bpmn:outgoing>Flow_15</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="end" name="End"><bpmn:incoming>Flow_15</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="Flow_1" sourceRef="ms" targetRef="sm1"/>
<bpmn:sequenceFlow id="Flow_2" sourceRef="sm1" targetRef="m1"/>
<bpmn:sequenceFlow id="Flow_3" sourceRef="m1" targetRef="m2"/>
<bpmn:sequenceFlow id="Flow_4" sourceRef="m2" targetRef="ev"/>
<bpmn:sequenceFlow id="Flow_5" sourceRef="ps" targetRef="sr"/>
<bpmn:sequenceFlow id="Flow_6" sourceRef="sr" targetRef="r1"/>
<bpmn:sequenceFlow id="Flow_7" sourceRef="r1" targetRef="occ"/>
<bpmn:sequenceFlow id="Flow_8" sourceRef="occ" targetRef="mk"/>
<bpmn:sequenceFlow id="Flow_9" sourceRef="mk" targetRef="r2"/>
<bpmn:sequenceFlow id="Flow_10" sourceRef="r2" targetRef="ev"/>
<bpmn:sequenceFlow id="Flow_11" sourceRef="ev" targetRef="ing"/>
<bpmn:sequenceFlow id="Flow_12" sourceRef="ing" targetRef="rev"/>
<bpmn:sequenceFlow id="Flow_13" sourceRef="rev" targetRef="gen"/>
<bpmn:sequenceFlow id="Flow_14" sourceRef="gen" targetRef="pub"/>
<bpmn:sequenceFlow id="Flow_15" sourceRef="pub" targetRef="end"/>
<bpmn:group id="Group_1" categoryValueRef="CatVal_1"/>
<bpmn:group id="Group_2" categoryValueRef="CatVal_2"/>
<bpmn:group id="Group_3" categoryValueRef="CatVal_3"/>
<bpmn:group id="Group_4" categoryValueRef="CatVal_4"/>
</bpmn:process>
<bpmn:category id="Cat_1"><bpmn:categoryValue id="CatVal_1" value="ONE-TIME SETUP"/></bpmn:category>
<bpmn:category id="Cat_2"><bpmn:categoryValue id="CatVal_2" value="RECURRING EXECUTION"/></bpmn:category>
<bpmn:category id="Cat_3"><bpmn:categoryValue id="CatVal_3" value="COMMON SITESCOPE WORKFLOW"/></bpmn:category>
<bpmn:category id="Cat_4"><bpmn:categoryValue id="CatVal_4" value="C1: Review and report publication"/></bpmn:category>

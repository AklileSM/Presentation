<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_02" targetNamespace="https://sitescope.smart-crg.com/bpmn" exporter="SiteScope BPMN generator" exporterVersion="1.0">
<bpmn:collaboration id="Collab_02"><bpmn:participant id="Pool_02" name="02 · Joining the platform and getting access" processRef="Process_02"/>
</bpmn:collaboration>
<bpmn:process id="Process_02" isExecutable="false">
<bpmn:laneSet id="LaneSet_02">
<bpmn:lane id="Lane_u" name="Visitor / user and SiteScope"><bpmn:flowNodeRef>s0</bpmn:flowNodeRef><bpmn:flowNodeRef>w</bpmn:flowNodeRef><bpmn:flowNodeRef>rf</bpmn:flowNodeRef><bpmn:flowNodeRef>fx</bpmn:flowNodeRef><bpmn:flowNodeRef>dup</bpmn:flowNodeRef><bpmn:flowNodeRef>mk</bpmn:flowNodeRef><bpmn:flowNodeRef>reg</bpmn:flowNodeRef><bpmn:flowNodeRef>lf</bpmn:flowNodeRef><bpmn:flowNodeRef>cred</bpmn:flowNodeRef><bpmn:flowNodeRef>bad</bpmn:flowNodeRef><bpmn:flowNodeRef>act</bpmn:flowNodeRef><bpmn:flowNodeRef>dis</bpmn:flowNodeRef><bpmn:flowNodeRef>in</bpmn:flowNodeRef><bpmn:flowNodeRef>rq</bpmn:flowNodeRef><bpmn:flowNodeRef>gen</bpmn:flowNodeRef><bpmn:flowNodeRef>click</bpmn:flowNodeRef><bpmn:flowNodeRef>valid</bpmn:flowNodeRef><bpmn:flowNodeRef>exp</bpmn:flowNodeRef><bpmn:flowNodeRef>np</bpmn:flowNodeRef><bpmn:flowNodeRef>done</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="s0" name="Open the app"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
<bpmn:exclusiveGateway id="w" name="What do you want to do?"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing><bpmn:outgoing>Flow_7</bpmn:outgoing><bpmn:outgoing>Flow_13</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="rf" name="Fill in username, email and password"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="fx" name="Username or email already registered?"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="dup" name="Registration refused"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:errorEventDefinition id="EED_dup"/></bpmn:endEvent>
<bpmn:serviceTask id="mk" name="Create account (the very first account becomes Administrator); email a 7-day verification link"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="reg" name="Account created and logged in"><bpmn:incoming>Flow_6</bpmn:incoming></bpmn:endEvent>
<bpmn:userTask id="lf" name="Enter username and password"><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="cred" name="Correct credentials?"><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="bad" name="Incorrect username or password"><bpmn:incoming>Flow_9</bpmn:incoming><bpmn:errorEventDefinition id="EED_bad"/></bpmn:endEvent>
<bpmn:exclusiveGateway id="act" name="Account active?"><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing><bpmn:outgoing>Flow_12</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="dis" name="Account disabled by an administrator"><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:errorEventDefinition id="EED_dis"/></bpmn:endEvent>
<bpmn:endEvent id="in" name="Logged in (7-day token)"><bpmn:incoming>Flow_12</bpmn:incoming></bpmn:endEvent>
<bpmn:userTask id="rq" name="Enter the account's email address"><bpmn:incoming>Flow_13</bpmn:incoming><bpmn:outgoing>Flow_14</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="gen" name="Email a 1-hour reset link only to active, verified accounts; same reply either way"><bpmn:incoming>Flow_14</bpmn:incoming><bpmn:outgoing>Flow_15</bpmn:outgoing></bpmn:serviceTask>
<bpmn:userTask id="click" name="Open the reset link"><bpmn:incoming>Flow_15</bpmn:incoming><bpmn:outgoing>Flow_16</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="valid" name="Link still valid?"><bpmn:incoming>Flow_16</bpmn:incoming><bpmn:outgoing>Flow_17</bpmn:outgoing><bpmn:outgoing>Flow_18</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="exp" name="Link expired: request a new one"><bpmn:incoming>Flow_17</bpmn:incoming><bpmn:errorEventDefinition id="EED_exp"/></bpmn:endEvent>
<bpmn:userTask id="np" name="Enter and confirm the new password"><bpmn:incoming>Flow_18</bpmn:incoming><bpmn:outgoing>Flow_19</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="done" name="Password updated"><bpmn:incoming>Flow_19</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="Flow_1" sourceRef="s0" targetRef="w"/>
<bpmn:sequenceFlow id="Flow_2" name="Register" sourceRef="w" targetRef="rf"/>
<bpmn:sequenceFlow id="Flow_3" sourceRef="rf" targetRef="fx"/>
<bpmn:sequenceFlow id="Flow_4" name="Yes" sourceRef="fx" targetRef="dup"/>
<bpmn:sequenceFlow id="Flow_5" name="No" sourceRef="fx" targetRef="mk"/>
<bpmn:sequenceFlow id="Flow_6" sourceRef="mk" targetRef="reg"/>
<bpmn:sequenceFlow id="Flow_7" name="Log in" sourceRef="w" targetRef="lf"/>
<bpmn:sequenceFlow id="Flow_8" sourceRef="lf" targetRef="cred"/>
<bpmn:sequenceFlow id="Flow_9" name="No" sourceRef="cred" targetRef="bad"/>
<bpmn:sequenceFlow id="Flow_10" name="Yes" sourceRef="cred" targetRef="act"/>
<bpmn:sequenceFlow id="Flow_11" name="No" sourceRef="act" targetRef="dis"/>
<bpmn:sequenceFlow id="Flow_12" name="Yes" sourceRef="act" targetRef="in"/>
<bpmn:sequenceFlow id="Flow_13" name="Reset password" sourceRef="w" targetRef="rq"/>
<bpmn:sequenceFlow id="Flow_14" sourceRef="rq" targetRef="gen"/>
<bpmn:sequenceFlow id="Flow_15" sourceRef="gen" targetRef="click"/>
<bpmn:sequenceFlow id="Flow_16" sourceRef="click" targetRef="valid"/>
<bpmn:sequenceFlow id="Flow_17" name="No" sourceRef="valid" targetRef="exp"/>
<bpmn:sequenceFlow id="Flow_18" name="Yes" sourceRef="valid" targetRef="np"/>
<bpmn:sequenceFlow id="Flow_19" sourceRef="np" targetRef="done"/>
<bpmn:textAnnotation id="Note_1"><bpmn:text>Verifying the email (link from registration, or Resend on the profile page) is required before a password can be reset, so nobody can take over an account registered against someone else's address.</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="Note_2"><bpmn:text>Robot accounts are not registered here: an administrator creates them pre-verified (diagram 10).</bpmn:text></bpmn:textAnnotation>
</bpmn:process>

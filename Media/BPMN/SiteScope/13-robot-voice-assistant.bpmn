<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_13" targetNamespace="https://sitescope.smart-crg.com/bpmn" exporter="SiteScope BPMN generator" exporterVersion="1.0">
<bpmn:collaboration id="Collab_13"><bpmn:participant id="Pool_13" name="13 · Robot voice assistant (Robots page)" processRef="Process_13"/>
</bpmn:collaboration>
<bpmn:process id="Process_13" isExecutable="false">
<bpmn:laneSet id="LaneSet_13">
<bpmn:lane id="Lane_u" name="Operator (browser)"><bpmn:flowNodeRef>s0</bpmn:flowNodeRef><bpmn:flowNodeRef>say</bpmn:flowNodeRef><bpmn:flowNodeRef>hear</bpmn:flowNodeRef><bpmn:flowNodeRef>more</bpmn:flowNodeRef><bpmn:flowNodeRef>e</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_r" name="Robot agent"><bpmn:flowNodeRef>cmd</bpmn:flowNodeRef><bpmn:flowNodeRef>acts</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_s" name="SiteScope backend: assistant"><bpmn:flowNodeRef>msg</bpmn:flowNodeRef><bpmn:flowNodeRef>stop</bpmn:flowNodeRef><bpmn:flowNodeRef>rule</bpmn:flowNodeRef><bpmn:flowNodeRef>mode</bpmn:flowNodeRef><bpmn:flowNodeRef>llm</bpmn:flowNodeRef><bpmn:flowNodeRef>rb</bpmn:flowNodeRef><bpmn:flowNodeRef>val</bpmn:flowNodeRef><bpmn:flowNodeRef>ok</bpmn:flowNodeRef><bpmn:flowNodeRef>ask</bpmn:flowNodeRef><bpmn:flowNodeRef>conf</bpmn:flowNodeRef><bpmn:flowNodeRef>rd</bpmn:flowNodeRef><bpmn:flowNodeRef>do</bpmn:flowNodeRef><bpmn:flowNodeRef>reply</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="s0" name="Open the assistant"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
<bpmn:userTask id="say" name="Speak (browser speech recognition) or type a request"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:incoming>Flow_24</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="msg" name="Receive message with conversation state"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="stop" name="Stop, cancel or a yes / no answer?"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="rule" name="Handle with coded rules immediately"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_18</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="mode" name="Language model enabled and reachable?"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="llm" name="Model picks a tool: set_fields, propose / create / manage schedule, start_trip, connect, disconnect, stop, open_tab"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="rb" name="Rule-based parser (time, weekdays, waypoints, capture type)"><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="val" name="Validate: waypoints on the current map, capture type available, time from the user's own words"><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:incoming>Flow_9</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="ok" name="Anything missing or invalid?"><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing><bpmn:outgoing>Flow_12</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="ask" name="Ask a question (e.g. “Which days should it run?”)"><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_19</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="conf" name="Needs confirmation?"><bpmn:incoming>Flow_12</bpmn:incoming><bpmn:outgoing>Flow_13</bpmn:outgoing><bpmn:outgoing>Flow_14</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="rd" name="Read back the draft / “Should I connect it?” / “Delete …? It can't be undone.”"><bpmn:incoming>Flow_13</bpmn:incoming><bpmn:outgoing>Flow_20</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="do" name="Act through the Robots page endpoints and permission checks"><bpmn:incoming>Flow_14</bpmn:incoming><bpmn:outgoing>Flow_15</bpmn:outgoing><bpmn:outgoing>Flow_17</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="cmd" name="Claim the queued mission, Connect or Stop"><bpmn:incoming>Flow_15</bpmn:incoming><bpmn:outgoing>Flow_16</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="acts" name="Robot acts"><bpmn:incoming>Flow_16</bpmn:incoming></bpmn:endEvent>
<bpmn:serviceTask id="reply" name="Reply text; speech from Kokoro TTS, or the browser voice as fallback"><bpmn:incoming>Flow_17</bpmn:incoming><bpmn:incoming>Flow_18</bpmn:incoming><bpmn:incoming>Flow_19</bpmn:incoming><bpmn:incoming>Flow_20</bpmn:incoming><bpmn:outgoing>Flow_21</bpmn:outgoing></bpmn:serviceTask>
<bpmn:userTask id="hear" name="Hear / read the reply"><bpmn:incoming>Flow_21</bpmn:incoming><bpmn:outgoing>Flow_22</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="more" name="Continue?"><bpmn:incoming>Flow_22</bpmn:incoming><bpmn:outgoing>Flow_23</bpmn:outgoing><bpmn:outgoing>Flow_24</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="e" name="Conversation ends"><bpmn:incoming>Flow_23</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="Flow_1" sourceRef="s0" targetRef="say"/>
<bpmn:sequenceFlow id="Flow_2" sourceRef="say" targetRef="msg"/>
<bpmn:sequenceFlow id="Flow_3" sourceRef="msg" targetRef="stop"/>
<bpmn:sequenceFlow id="Flow_4" name="Yes" sourceRef="stop" targetRef="rule"/>
<bpmn:sequenceFlow id="Flow_5" name="No" sourceRef="stop" targetRef="mode"/>
<bpmn:sequenceFlow id="Flow_6" name="Yes" sourceRef="mode" targetRef="llm"/>
<bpmn:sequenceFlow id="Flow_7" name="No" sourceRef="mode" targetRef="rb"/>
<bpmn:sequenceFlow id="Flow_8" sourceRef="llm" targetRef="val"/>
<bpmn:sequenceFlow id="Flow_9" sourceRef="rb" targetRef="val"/>
<bpmn:sequenceFlow id="Flow_10" sourceRef="val" targetRef="ok"/>
<bpmn:sequenceFlow id="Flow_11" name="Yes" sourceRef="ok" targetRef="ask"/>
<bpmn:sequenceFlow id="Flow_12" name="No" sourceRef="ok" targetRef="conf"/>
<bpmn:sequenceFlow id="Flow_13" name="Yes" sourceRef="conf" targetRef="rd"/>
<bpmn:sequenceFlow id="Flow_14" name="No / confirmed" sourceRef="conf" targetRef="do"/>
<bpmn:sequenceFlow id="Flow_15" sourceRef="do" targetRef="cmd"/>
<bpmn:sequenceFlow id="Flow_16" sourceRef="cmd" targetRef="acts"/>
<bpmn:sequenceFlow id="Flow_17" sourceRef="do" targetRef="reply"/>
<bpmn:sequenceFlow id="Flow_18" sourceRef="rule" targetRef="reply"/>
<bpmn:sequenceFlow id="Flow_19" sourceRef="ask" targetRef="reply"/>
<bpmn:sequenceFlow id="Flow_20" sourceRef="rd" targetRef="reply"/>
<bpmn:sequenceFlow id="Flow_21" sourceRef="reply" targetRef="hear"/>
<bpmn:sequenceFlow id="Flow_22" sourceRef="hear" targetRef="more"/>
<bpmn:sequenceFlow id="Flow_23" name="No" sourceRef="more" targetRef="e"/>
<bpmn:sequenceFlow id="Flow_24" name="Yes" sourceRef="more" targetRef="say"/>
<bpmn:textAnnotation id="Note_1"><bpmn:text>ASSISTANT_AGENT = off (rules only), schedules (model only for creating schedules) or all. A schedule is created only from an unchanged, read-back draft.</bpmn:text></bpmn:textAnnotation>
</bpmn:process>

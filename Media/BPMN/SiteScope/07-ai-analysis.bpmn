<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_07" targetNamespace="https://sitescope.smart-crg.com/bpmn" exporter="SiteScope BPMN generator" exporterVersion="1.0">
<bpmn:collaboration id="Collab_07"><bpmn:participant id="Pool_07" name="07 · Analysing an image with AI" processRef="Process_07"/>
</bpmn:collaboration>
<bpmn:process id="Process_07" isExecutable="false">
<bpmn:laneSet id="LaneSet_07">
<bpmn:lane id="Lane_u" name="Viewer (browser)"><bpmn:flowNodeRef>open</bpmn:flowNodeRef><bpmn:flowNodeRef>ask</bpmn:flowNodeRef><bpmn:flowNodeRef>poll</bpmn:flowNodeRef><bpmn:flowNodeRef>show</bpmn:flowNodeRef><bpmn:flowNodeRef>e</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_s" name="SiteScope backend"><bpmn:flowNodeRef>st</bpmn:flowNodeRef><bpmn:flowNodeRef>ret</bpmn:flowNodeRef><bpmn:flowNodeRef>run_q</bpmn:flowNodeRef><bpmn:flowNodeRef>inprog</bpmn:flowNodeRef><bpmn:flowNodeRef>up</bpmn:flowNodeRef><bpmn:flowNodeRef>bg</bpmn:flowNodeRef><bpmn:flowNodeRef>done</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_m" name="Vision model (OpenAI-compatible: local Ollama or cloud)"><bpmn:flowNodeRef>run</bpmn:flowNodeRef><bpmn:flowNodeRef>got</bpmn:flowNodeRef><bpmn:flowNodeRef>failed</bpmn:flowNodeRef><bpmn:flowNodeRef>fe</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="open" name="User opens the image"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
<bpmn:serviceTask id="ask" name="Request the AI description"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="st" name="Description stored?"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="ret" name="Return the stored description"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_16</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="run_q" name="Analysis already running?"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="inprog" name="Reply “in progress” (202)"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="poll" name="Poll every 2 s"><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:serviceTask>
<bpmn:startEvent id="up" name="Image uploaded (by a person or the robot)"><bpmn:outgoing>Flow_9</bpmn:outgoing><bpmn:messageEventDefinition id="MED_up"/></bpmn:startEvent>
<bpmn:serviceTask id="bg" name="Mark Generating; start background analysis"><bpmn:incoming>Flow_9</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="run" name="Send the image with the SCENE / QUALITY ISSUES / SAFETY ISSUES prompt"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="got" name="Description returned?"><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_12</bpmn:outgoing><bpmn:outgoing>Flow_13</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="done" name="Save description; status Done"><bpmn:incoming>Flow_12</bpmn:incoming><bpmn:outgoing>Flow_15</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="failed" name="Status Failed; uploads, viewing and reports are unaffected"><bpmn:incoming>Flow_13</bpmn:incoming><bpmn:outgoing>Flow_14</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="fe" name="No description"><bpmn:incoming>Flow_14</bpmn:incoming></bpmn:endEvent>
<bpmn:userTask id="show" name="Show the description in the viewer"><bpmn:incoming>Flow_15</bpmn:incoming><bpmn:incoming>Flow_16</bpmn:incoming><bpmn:outgoing>Flow_17</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="e" name="AI description visible"><bpmn:incoming>Flow_17</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="Flow_1" sourceRef="open" targetRef="ask"/>
<bpmn:sequenceFlow id="Flow_2" sourceRef="ask" targetRef="st"/>
<bpmn:sequenceFlow id="Flow_3" name="Yes" sourceRef="st" targetRef="ret"/>
<bpmn:sequenceFlow id="Flow_4" name="No" sourceRef="st" targetRef="run_q"/>
<bpmn:sequenceFlow id="Flow_5" name="Yes" sourceRef="run_q" targetRef="inprog"/>
<bpmn:sequenceFlow id="Flow_6" name="No" sourceRef="run_q" targetRef="run"/>
<bpmn:sequenceFlow id="Flow_7" sourceRef="inprog" targetRef="poll"/>
<bpmn:sequenceFlow id="Flow_8" sourceRef="poll" targetRef="ask"/>
<bpmn:sequenceFlow id="Flow_9" sourceRef="up" targetRef="bg"/>
<bpmn:sequenceFlow id="Flow_10" sourceRef="bg" targetRef="run"/>
<bpmn:sequenceFlow id="Flow_11" sourceRef="run" targetRef="got"/>
<bpmn:sequenceFlow id="Flow_12" name="Yes" sourceRef="got" targetRef="done"/>
<bpmn:sequenceFlow id="Flow_13" name="No" sourceRef="got" targetRef="failed"/>
<bpmn:sequenceFlow id="Flow_14" sourceRef="failed" targetRef="fe"/>
<bpmn:sequenceFlow id="Flow_15" sourceRef="done" targetRef="show"/>
<bpmn:sequenceFlow id="Flow_16" sourceRef="ret" targetRef="show"/>
<bpmn:sequenceFlow id="Flow_17" sourceRef="show" targetRef="e"/>
</bpmn:process>
<bpmndi:BPMNDiagram id="Diagram_07"><bpmndi:BPMNPlane id="Plane_07" bpmnElement="Collab_07">
<bpmndi:BPMNShape id="Pool_07_di" bpmnElement="Pool_07" isHorizontal="true"><dc:Bounds x="20" y="20" width="1493" height="835"/></bpmndi:BPMNShape>

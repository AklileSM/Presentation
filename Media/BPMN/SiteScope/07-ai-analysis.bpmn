<bpmndi:BPMNShape id="open_di" bpmnElement="open"><dc:Bounds x="192" y="100" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="150" y="142" width="120" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>

<bpmndi:BPMNShape id="inprog_di" bpmnElement="inprog"><dc:Bounds x="835" y="392" width="150" height="90"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="poll_di" bpmnElement="poll"><dc:Bounds x="1010" y="72" width="150" height="90"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="up_di" bpmnElement="up"><dc:Bounds x="192" y="544" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="150" y="586" width="120" height="42"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="bg_di" bpmnElement="bg"><dc:Bounds x="310" y="518" width="150" height="90"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="run_di" bpmnElement="run"><dc:Bounds x="835" y="712" width="150" height="90"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="got_di" bpmnElement="got" isMarkerVisible="true"><dc:Bounds x="1060" y="732" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="1025" y="788" width="120" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="done_di" bpmnElement="done"><dc:Bounds x="1185" y="392" width="150" height="90"/></bpmndi:BPMNShape>

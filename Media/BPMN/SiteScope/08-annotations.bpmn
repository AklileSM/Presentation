<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_08" targetNamespace="https://sitescope.smart-crg.com/bpmn" exporter="SiteScope BPMN generator" exporterVersion="1.0">
<bpmn:collaboration id="Collab_08"><bpmn:participant id="Pool_08" name="08 · Annotating an image" processRef="Process_08"/>
</bpmn:collaboration>
<bpmn:process id="Process_08" isExecutable="false">
<bpmn:laneSet id="LaneSet_08">
<bpmn:lane id="Lane_u" name="User in the image viewer"><bpmn:flowNodeRef>s0</bpmn:flowNodeRef><bpmn:flowNodeRef>role</bpmn:flowNodeRef><bpmn:flowNodeRef>ro</bpmn:flowNodeRef><bpmn:flowNodeRef>m</bpmn:flowNodeRef><bpmn:flowNodeRef>what</bpmn:flowNodeRef><bpmn:flowNodeRef>place</bpmn:flowNodeRef><bpmn:flowNodeRef>sel</bpmn:flowNodeRef><bpmn:flowNodeRef>own</bpmn:flowNodeRef><bpmn:flowNodeRef>no</bpmn:flowNodeRef><bpmn:flowNodeRef>ed</bpmn:flowNodeRef><bpmn:flowNodeRef>redraw</bpmn:flowNodeRef><bpmn:flowNodeRef>again</bpmn:flowNodeRef><bpmn:flowNodeRef>e</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_s" name="SiteScope backend"><bpmn:flowNodeRef>api</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="s0" name="Open an image"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
<bpmn:exclusiveGateway id="role" name="Owner, Editor or admin?"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="ro" name="Read-only: pins visible, tools hidden"><bpmn:incoming>Flow_2</bpmn:incoming></bpmn:endEvent>
<bpmn:exclusiveGateway id="m" name=""><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:incoming>Flow_15</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="what" name="Add or change?"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="place" name="Click to place a pin; fill note, flag (Safety / Quality / Delayed), optional link and photo"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="sel" name="Select an existing pin"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="own" name="Created by you (or you are admin)?"><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="no" name="Edit / delete hidden in the UI"><bpmn:incoming>Flow_9</bpmn:incoming></bpmn:endEvent>
<bpmn:userTask id="ed" name="Edit the pin or delete it"><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="api" name="Save, update or delete the annotation; store / remove the attachment in MinIO"><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_12</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="redraw" name="Redraw the annotation layer"><bpmn:incoming>Flow_12</bpmn:incoming><bpmn:outgoing>Flow_13</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="again" name="Another?"><bpmn:incoming>Flow_13</bpmn:incoming><bpmn:outgoing>Flow_14</bpmn:outgoing><bpmn:outgoing>Flow_15</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="e" name="Done"><bpmn:incoming>Flow_14</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="Flow_1" sourceRef="s0" targetRef="role"/>
<bpmn:sequenceFlow id="Flow_2" name="No" sourceRef="role" targetRef="ro"/>
<bpmn:sequenceFlow id="Flow_3" name="Yes" sourceRef="role" targetRef="m"/>
<bpmn:sequenceFlow id="Flow_4" sourceRef="m" targetRef="what"/>
<bpmn:sequenceFlow id="Flow_5" name="Add" sourceRef="what" targetRef="place"/>
<bpmn:sequenceFlow id="Flow_6" name="Change" sourceRef="what" targetRef="sel"/>
<bpmn:sequenceFlow id="Flow_7" sourceRef="place" targetRef="api"/>
<bpmn:sequenceFlow id="Flow_8" sourceRef="sel" targetRef="own"/>
<bpmn:sequenceFlow id="Flow_9" name="No" sourceRef="own" targetRef="no"/>
<bpmn:sequenceFlow id="Flow_10" name="Yes" sourceRef="own" targetRef="ed"/>
<bpmn:sequenceFlow id="Flow_11" sourceRef="ed" targetRef="api"/>
<bpmn:sequenceFlow id="Flow_12" sourceRef="api" targetRef="redraw"/>
<bpmn:sequenceFlow id="Flow_13" sourceRef="redraw" targetRef="again"/>
<bpmn:sequenceFlow id="Flow_14" name="No" sourceRef="again" targetRef="e"/>
<bpmn:sequenceFlow id="Flow_15" name="Yes" sourceRef="again" targetRef="m"/>
<bpmn:textAnnotation id="Note_1"><bpmn:text>Gap found in the code: the API does not check roles or the pin's creator for create / edit / delete (any logged-in user can call them), and listing a file's pins needs no login. Only the UI enforces these rules.</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="Assoc_1" sourceRef="api" targetRef="Note_1"/>
</bpmn:process>

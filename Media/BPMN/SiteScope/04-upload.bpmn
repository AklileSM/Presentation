<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_04" targetNamespace="https://sitescope.smart-crg.com/bpmn" exporter="SiteScope BPMN generator" exporterVersion="1.0">
<bpmn:collaboration id="Collab_04"><bpmn:participant id="Pool_04" name="04 · Uploading site documentation" processRef="Process_04"/>
</bpmn:collaboration>
<bpmn:process id="Process_04" isExecutable="false">
<bpmn:laneSet id="LaneSet_04">
<bpmn:lane id="Lane_u" name="User (Owner / Editor) or robot agent"><bpmn:flowNodeRef>s0</bpmn:flowNodeRef><bpmn:flowNodeRef>w</bpmn:flowNodeRef><bpmn:flowNodeRef>st</bpmn:flowNodeRef><bpmn:flowNodeRef>sub</bpmn:flowNodeRef><bpmn:flowNodeRef>rob</bpmn:flowNodeRef><bpmn:flowNodeRef>pst</bpmn:flowNodeRef><bpmn:flowNodeRef>direct</bpmn:flowNodeRef><bpmn:flowNodeRef>pre</bpmn:flowNodeRef><bpmn:flowNodeRef>chunk</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_s" name="SiteScope backend"><bpmn:flowNodeRef>chk</bpmn:flowNodeRef><bpmn:flowNodeRef>asm</bpmn:flowNodeRef><bpmn:flowNodeRef>hash</bpmn:flowNodeRef><bpmn:flowNodeRef>dup</bpmn:flowNodeRef><bpmn:flowNodeRef>rej</bpmn:flowNodeRef><bpmn:flowNodeRef>save</bpmn:flowNodeRef><bpmn:flowNodeRef>kind</bpmn:flowNodeRef><bpmn:flowNodeRef>img</bpmn:flowNodeRef><bpmn:flowNodeRef>pc</bpmn:flowNodeRef><bpmn:flowNodeRef>j</bpmn:flowNodeRef><bpmn:flowNodeRef>act</bpmn:flowNodeRef><bpmn:flowNodeRef>vis</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="s0" name="Files to upload"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
<bpmn:exclusiveGateway id="w" name="Source and file type?"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing><bpmn:outgoing>Flow_4</bpmn:outgoing><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="st" name="Stage files: pick room and capture date; browser hashes each file (duplicates flagged)"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="sub" name="Upload (single request)"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="rob" name="Robot uploads capture with project, room, date and metadata (pose, mission, waypoint, sensor, quality)"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="chk" name="Check the robot is Owner / Editor and the room exists"><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:serviceTask>
<bpmn:userTask id="pst" name="Stage LAZ / LAS point clouds"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="direct" name="Direct-to-storage available?"><bpmn:incoming>Flow_9</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing><bpmn:outgoing>Flow_11</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="pre" name="Browser PUTs the file to storage with a one-time URL"><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_12</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="chunk" name="Chunked upload: 64 MB pieces, up to 5 in parallel, 3 retries each"><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_13</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="asm" name="Confirm or assemble the file"><bpmn:incoming>Flow_12</bpmn:incoming><bpmn:incoming>Flow_13</bpmn:incoming><bpmn:outgoing>Flow_14</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="hash" name="Compute SHA-256"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:incoming>Flow_14</bpmn:incoming><bpmn:outgoing>Flow_15</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="dup" name="Same file already uploaded anywhere?"><bpmn:incoming>Flow_15</bpmn:incoming><bpmn:outgoing>Flow_16</bpmn:outgoing><bpmn:outgoing>Flow_17</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="rej" name="Rejected: already uploaded (409)"><bpmn:incoming>Flow_16</bpmn:incoming><bpmn:errorEventDefinition id="EED_rej"/></bpmn:endEvent>
<bpmn:serviceTask id="save" name="Store in MinIO; create the file record"><bpmn:incoming>Flow_17</bpmn:incoming><bpmn:outgoing>Flow_18</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="kind" name="Media type?"><bpmn:incoming>Flow_18</bpmn:incoming><bpmn:outgoing>Flow_19</bpmn:outgoing><bpmn:outgoing>Flow_20</bpmn:outgoing><bpmn:outgoing>Flow_21</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="img" name="Thumbnail (400×300); start AI description in the background (07)"><bpmn:incoming>Flow_19</bpmn:incoming><bpmn:outgoing>Flow_22</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="pc" name="Status Pending; submit to the converter pool (05)"><bpmn:incoming>Flow_20</bpmn:incoming><bpmn:outgoing>Flow_23</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="j" name=""><bpmn:incoming>Flow_21</bpmn:incoming><bpmn:incoming>Flow_22</bpmn:incoming><bpmn:incoming>Flow_23</bpmn:incoming><bpmn:outgoing>Flow_24</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="act" name="Log activity (source: user or robot)"><bpmn:incoming>Flow_24</bpmn:incoming><bpmn:outgoing>Flow_25</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="vis" name="File visible in the explorer"><bpmn:incoming>Flow_25</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="Flow_1" sourceRef="s0" targetRef="w"/>
<bpmn:sequenceFlow id="Flow_2" name="Image / video / PDF" sourceRef="w" targetRef="st"/>
<bpmn:sequenceFlow id="Flow_3" sourceRef="st" targetRef="sub"/>
<bpmn:sequenceFlow id="Flow_4" name="Robot capture" sourceRef="w" targetRef="rob"/>
<bpmn:sequenceFlow id="Flow_5" name="Point cloud" sourceRef="w" targetRef="pst"/>
<bpmn:sequenceFlow id="Flow_6" sourceRef="sub" targetRef="hash"/>
<bpmn:sequenceFlow id="Flow_7" sourceRef="rob" targetRef="chk"/>
<bpmn:sequenceFlow id="Flow_8" sourceRef="chk" targetRef="hash"/>
<bpmn:sequenceFlow id="Flow_9" sourceRef="pst" targetRef="direct"/>
<bpmn:sequenceFlow id="Flow_10" name="Yes" sourceRef="direct" targetRef="pre"/>
<bpmn:sequenceFlow id="Flow_11" name="No" sourceRef="direct" targetRef="chunk"/>
<bpmn:sequenceFlow id="Flow_12" sourceRef="pre" targetRef="asm"/>
<bpmn:sequenceFlow id="Flow_13" sourceRef="chunk" targetRef="asm"/>
<bpmn:sequenceFlow id="Flow_14" sourceRef="asm" targetRef="hash"/>
<bpmn:sequenceFlow id="Flow_15" sourceRef="hash" targetRef="dup"/>
<bpmn:sequenceFlow id="Flow_16" name="Yes" sourceRef="dup" targetRef="rej"/>
<bpmn:sequenceFlow id="Flow_17" name="No" sourceRef="dup" targetRef="save"/>
<bpmn:sequenceFlow id="Flow_18" sourceRef="save" targetRef="kind"/>
<bpmn:sequenceFlow id="Flow_19" name="Image" sourceRef="kind" targetRef="img"/>
<bpmn:sequenceFlow id="Flow_20" name="Point cloud" sourceRef="kind" targetRef="pc"/>
<bpmn:sequenceFlow id="Flow_21" name="Video / PDF" sourceRef="kind" targetRef="j"/>
<bpmn:sequenceFlow id="Flow_22" sourceRef="img" targetRef="j"/>
<bpmn:sequenceFlow id="Flow_23" sourceRef="pc" targetRef="j"/>
<bpmn:sequenceFlow id="Flow_24" sourceRef="j" targetRef="act"/>
<bpmn:sequenceFlow id="Flow_25" sourceRef="act" targetRef="vis"/>
<bpmn:textAnnotation id="Note_1"><bpmn:text>Duplicate check is two-layered: the browser asks /precheck-hash before sending, and the server re-checks the hash before storing.</bpmn:text></bpmn:textAnnotation>
</bpmn:process>

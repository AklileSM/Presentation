<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_12" targetNamespace="https://sitescope.smart-crg.com/bpmn" exporter="SiteScope BPMN generator" exporterVersion="1.0">
<bpmn:collaboration id="Collab_12"><bpmn:participant id="Pool_12" name="12 · Mission execution: navigate, capture, upload, return home" processRef="Process_12"/>
</bpmn:collaboration>
<bpmn:process id="Process_12" isExecutable="false">
<bpmn:laneSet id="LaneSet_12">
<bpmn:lane id="Lane_op" name="Operator (web app)"><bpmn:flowNodeRef>cx</bpmn:flowNodeRef><bpmn:flowNodeRef>press</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_be" name="SiteScope backend"><bpmn:flowNodeRef>ing</bpmn:flowNodeRef><bpmn:flowNodeRef>close</bpmn:flowNodeRef><bpmn:flowNodeRef>done</bpmn:flowNodeRef><bpmn:flowNodeRef>req</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_ag" name="Robot agent (Jetson Orin NX)"><bpmn:flowNodeRef>s</bpmn:flowNodeRef><bpmn:flowNodeRef>run</bpmn:flowNodeRef><bpmn:flowNodeRef>hc</bpmn:flowNodeRef><bpmn:flowNodeRef>unsafe</bpmn:flowNodeRef><bpmn:flowNodeRef>pose</bpmn:flowNodeRef><bpmn:flowNodeRef>m</bpmn:flowNodeRef><bpmn:flowNodeRef>more</bpmn:flowNodeRef><bpmn:flowNodeRef>arr</bpmn:flowNodeRef><bpmn:flowNodeRef>fail</bpmn:flowNodeRef><bpmn:flowNodeRef>cont</bpmn:flowNodeRef><bpmn:flowNodeRef>q</bpmn:flowNodeRef><bpmn:flowNodeRef>ok</bpmn:flowNodeRef><bpmn:flowNodeRef>home</bpmn:flowNodeRef><bpmn:flowNodeRef>fin</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_ros" name="ROS 2 / Nav2"><bpmn:flowNodeRef>nav</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_cam" name="Insta360 X4 / Livox MID-360"><bpmn:flowNodeRef>cap</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="s" name="Mission claimed"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
<bpmn:serviceTask id="run" name="Post status running; emit “Task started”"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="hc" name="Nav2 and localization healthy?"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="unsafe" name="Task failed: navigation not safe"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:errorEventDefinition id="EED_unsafe"/></bpmn:endEvent>
<bpmn:serviceTask id="pose" name="Use saved home pose as the return target"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="m" name=""><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:incoming>Flow_15</bpmn:incoming><bpmn:incoming>Flow_16</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="more" name="Another capture point?"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing><bpmn:outgoing>Flow_18</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="nav" name="NavigateToPose to the capture point (x, y, yaw)"><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="arr" name="Arrived?"><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="cap" name="Capture 360° photo and / or 10 s LiDAR scan"><bpmn:incoming>Flow_9</bpmn:incoming><bpmn:outgoing>Flow_12</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="fail" name="Record failed step"><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="cont" name="Continue on failure?"><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_16</bpmn:outgoing><bpmn:outgoing>Flow_17</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="q" name="Score image quality; in retry mode retake up to 3× and keep the best"><bpmn:incoming>Flow_12</bpmn:incoming><bpmn:outgoing>Flow_13</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="ing" name="Robot upload: store with project, room, date, mission, waypoint, sensor and pose; thumbnail, AI description, LAZ → Potree"><bpmn:incoming>Flow_13</bpmn:incoming><bpmn:outgoing>Flow_14</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="ok" name="Mark step succeeded"><bpmn:incoming>Flow_14</bpmn:incoming><bpmn:outgoing>Flow_15</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="home" name="Return to home pose (Nav2)"><bpmn:incoming>Flow_17</bpmn:incoming><bpmn:incoming>Flow_18</bpmn:incoming><bpmn:incoming>Flow_21</bpmn:incoming><bpmn:outgoing>Flow_22</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="fin" name="Post final status and step results"><bpmn:incoming>Flow_22</bpmn:incoming><bpmn:outgoing>Flow_23</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="close" name="Close mission and steps; robot idle; log activity"><bpmn:incoming>Flow_23</bpmn:incoming><bpmn:outgoing>Flow_24</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="done" name="Evidence available in SiteScope"><bpmn:incoming>Flow_24</bpmn:incoming></bpmn:endEvent>
<bpmn:startEvent id="cx" name="Operator wants to stop"><bpmn:outgoing>Flow_19</bpmn:outgoing><bpmn:conditionalEventDefinition id="CED_cx"><bpmn:condition xsi:type="bpmn:tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"/></bpmn:conditionalEventDefinition></bpmn:startEvent>
<bpmn:userTask id="press" name="Press Cancel (or Stop during the return)"><bpmn:incoming>Flow_19</bpmn:incoming><bpmn:outgoing>Flow_20</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="req" name="Mark cancel requested; agent's monitor cancels the active goal"><bpmn:incoming>Flow_20</bpmn:incoming><bpmn:outgoing>Flow_21</bpmn:outgoing></bpmn:serviceTask>
<bpmn:sequenceFlow id="Flow_1" sourceRef="s" targetRef="run"/>
<bpmn:sequenceFlow id="Flow_2" sourceRef="run" targetRef="hc"/>
<bpmn:sequenceFlow id="Flow_3" name="No" sourceRef="hc" targetRef="unsafe"/>
<bpmn:sequenceFlow id="Flow_4" name="Yes" sourceRef="hc" targetRef="pose"/>
<bpmn:sequenceFlow id="Flow_5" sourceRef="pose" targetRef="m"/>
<bpmn:sequenceFlow id="Flow_6" sourceRef="m" targetRef="more"/>
<bpmn:sequenceFlow id="Flow_7" name="Yes" sourceRef="more" targetRef="nav"/>
<bpmn:sequenceFlow id="Flow_8" sourceRef="nav" targetRef="arr"/>
<bpmn:sequenceFlow id="Flow_9" name="Yes" sourceRef="arr" targetRef="cap"/>
<bpmn:sequenceFlow id="Flow_10" name="No" sourceRef="arr" targetRef="fail"/>
<bpmn:sequenceFlow id="Flow_11" sourceRef="fail" targetRef="cont"/>
<bpmn:sequenceFlow id="Flow_12" sourceRef="cap" targetRef="q"/>
<bpmn:sequenceFlow id="Flow_13" sourceRef="q" targetRef="ing"/>
<bpmn:sequenceFlow id="Flow_14" sourceRef="ing" targetRef="ok"/>
<bpmn:sequenceFlow id="Flow_15" sourceRef="ok" targetRef="m"/>
<bpmn:sequenceFlow id="Flow_16" name="Yes" sourceRef="cont" targetRef="m"/>
<bpmn:sequenceFlow id="Flow_17" name="No" sourceRef="cont" targetRef="home"/>
<bpmn:sequenceFlow id="Flow_18" name="No" sourceRef="more" targetRef="home"/>
<bpmn:sequenceFlow id="Flow_19" sourceRef="cx" targetRef="press"/>
<bpmn:sequenceFlow id="Flow_20" sourceRef="press" targetRef="req"/>
<bpmn:sequenceFlow id="Flow_21" sourceRef="req" targetRef="home"/>
<bpmn:sequenceFlow id="Flow_22" sourceRef="home" targetRef="fin"/>
<bpmn:sequenceFlow id="Flow_23" sourceRef="fin" targetRef="close"/>
<bpmn:sequenceFlow id="Flow_24" sourceRef="close" targetRef="done"/>
<bpmn:textAnnotation id="Note_1"><bpmn:text>Every stage posts progress events (Going to…, Capturing…, Uploading…) shown live on the Progress tab and live map.</bpmn:text></bpmn:textAnnotation>
<bpmn:textAnnotation id="Note_2"><bpmn:text>If the robot stops reporting for 2 min during a cancellation, a watchdog marks it failed: the return was not confirmed.</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="Assoc_2" sourceRef="req" targetRef="Note_2"/>
</bpmn:process>

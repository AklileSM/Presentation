<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_03" targetNamespace="https://sitescope.smart-crg.com/bpmn" exporter="SiteScope BPMN generator" exporterVersion="1.0">
<bpmn:collaboration id="Collab_03"><bpmn:participant id="Pool_03" name="03 · Setting up a project and inviting the team" processRef="Process_03"/>
</bpmn:collaboration>
<bpmn:process id="Process_03" isExecutable="false">
<bpmn:laneSet id="LaneSet_03">
<bpmn:lane id="Lane_o" name="Project owner (Create project wizard, then Settings)"><bpmn:flowNodeRef>s0</bpmn:flowNodeRef><bpmn:flowNodeRef>det</bpmn:flowNodeRef><bpmn:flowNodeRef>rooms</bpmn:flowNodeRef><bpmn:flowNodeRef>fp</bpmn:flowNodeRef><bpmn:flowNodeRef>up</bpmn:flowNodeRef><bpmn:flowNodeRef>pins</bpmn:flowNodeRef><bpmn:flowNodeRef>j</bpmn:flowNodeRef><bpmn:flowNodeRef>mem</bpmn:flowNodeRef><bpmn:flowNodeRef>rob</bpmn:flowNodeRef><bpmn:flowNodeRef>setup</bpmn:flowNodeRef><bpmn:flowNodeRef>j2</bpmn:flowNodeRef><bpmn:flowNodeRef>ready</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_s" name="SiteScope backend"><bpmn:flowNodeRef>dup</bpmn:flowNodeRef><bpmn:flowNodeRef>ref</bpmn:flowNodeRef><bpmn:flowNodeRef>cr</bpmn:flowNodeRef><bpmn:flowNodeRef>log</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="s0" name="New project"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
<bpmn:userTask id="det" name="Step 1, Details: name, description, location"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="dup" name="You already own a project with this name?"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="ref" name="Pick another name"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:errorEventDefinition id="EED_ref"/></bpmn:endEvent>
<bpmn:serviceTask id="cr" name="Create project with an auto-generated unique slug; make you its Owner"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:serviceTask>
<bpmn:userTask id="rooms" name="Step 2, Rooms: add each location (e.g. Ground floor, Stairwell B)"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="fp" name="Upload a floor plan? (step 3)"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="up" name="Upload floor plan image"><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="pins" name="Step 4, Room pins: place each room on the floor plan"><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="j" name=""><bpmn:incoming>Flow_9</bpmn:incoming><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="mem" name="Settings › Members: search a registered user and add as Owner, Editor or Viewer"><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_12</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="log" name="Record membership changes in the activity feed"><bpmn:incoming>Flow_12</bpmn:incoming><bpmn:outgoing>Flow_13</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="rob" name="Will a robot inspect this site?"><bpmn:incoming>Flow_13</bpmn:incoming><bpmn:outgoing>Flow_14</bpmn:outgoing><bpmn:outgoing>Flow_16</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="setup" name="Settings › Setup: pair robot, robot map and capture points (diagram 10)"><bpmn:incoming>Flow_14</bpmn:incoming><bpmn:outgoing>Flow_15</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="j2" name=""><bpmn:incoming>Flow_15</bpmn:incoming><bpmn:incoming>Flow_16</bpmn:incoming><bpmn:outgoing>Flow_17</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="ready" name="Project ready for the team"><bpmn:incoming>Flow_17</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="Flow_1" sourceRef="s0" targetRef="det"/>
<bpmn:sequenceFlow id="Flow_2" sourceRef="det" targetRef="dup"/>
<bpmn:sequenceFlow id="Flow_3" name="Yes" sourceRef="dup" targetRef="ref"/>
<bpmn:sequenceFlow id="Flow_4" name="No" sourceRef="dup" targetRef="cr"/>
<bpmn:sequenceFlow id="Flow_5" sourceRef="cr" targetRef="rooms"/>
<bpmn:sequenceFlow id="Flow_6" sourceRef="rooms" targetRef="fp"/>
<bpmn:sequenceFlow id="Flow_7" name="Yes" sourceRef="fp" targetRef="up"/>
<bpmn:sequenceFlow id="Flow_8" sourceRef="up" targetRef="pins"/>
<bpmn:sequenceFlow id="Flow_9" sourceRef="pins" targetRef="j"/>
<bpmn:sequenceFlow id="Flow_10" name="Skip" sourceRef="fp" targetRef="j"/>
<bpmn:sequenceFlow id="Flow_11" sourceRef="j" targetRef="mem"/>
<bpmn:sequenceFlow id="Flow_12" sourceRef="mem" targetRef="log"/>
<bpmn:sequenceFlow id="Flow_13" sourceRef="log" targetRef="rob"/>
<bpmn:sequenceFlow id="Flow_14" name="Yes" sourceRef="rob" targetRef="setup"/>
<bpmn:sequenceFlow id="Flow_15" sourceRef="setup" targetRef="j2"/>
<bpmn:sequenceFlow id="Flow_16" name="No" sourceRef="rob" targetRef="j2"/>
<bpmn:sequenceFlow id="Flow_17" sourceRef="j2" targetRef="ready"/>
<bpmn:textAnnotation id="Note_1"><bpmn:text>Owner: everything, including settings and members. Editor: upload, delete, annotate, publish reports. Viewer: read-only. Admins see every project.</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="Assoc_1" sourceRef="mem" targetRef="Note_1"/>
</bpmn:process>
<bpmndi:BPMNDiagram id="Diagram_03"><bpmndi:BPMNPlane id="Plane_03" bpmnElement="Collab_03">

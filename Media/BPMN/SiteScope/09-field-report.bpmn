<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_09" targetNamespace="https://sitescope.smart-crg.com/bpmn" exporter="SiteScope BPMN generator" exporterVersion="1.0">
<bpmn:collaboration id="Collab_09"><bpmn:participant id="Pool_09" name="09 · Writing and publishing a field report" processRef="Process_09"/>
</bpmn:collaboration>
<bpmn:process id="Process_09" isExecutable="false">
<bpmn:laneSet id="LaneSet_09">
<bpmn:lane id="Lane_u" name="User (Editor or Owner)"><bpmn:flowNodeRef>s0</bpmn:flowNodeRef><bpmn:flowNodeRef>t</bpmn:flowNodeRef><bpmn:flowNodeRef>v1</bpmn:flowNodeRef><bpmn:flowNodeRef>v2</bpmn:flowNodeRef><bpmn:flowNodeRef>v3</bpmn:flowNodeRef><bpmn:flowNodeRef>v4</bpmn:flowNodeRef><bpmn:flowNodeRef>c1</bpmn:flowNodeRef><bpmn:flowNodeRef>c2</bpmn:flowNodeRef><bpmn:flowNodeRef>c3</bpmn:flowNodeRef><bpmn:flowNodeRef>more</bpmn:flowNodeRef><bpmn:flowNodeRef>c4</bpmn:flowNodeRef><bpmn:flowNodeRef>j</bpmn:flowNodeRef><bpmn:flowNodeRef>pdf</bpmn:flowNodeRef><bpmn:flowNodeRef>e</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_s" name="SiteScope backend"><bpmn:flowNodeRef>pub</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="s0" name="Start a report"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
<bpmn:exclusiveGateway id="t" name="Report type?"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="v1" name="Open a file in a viewer (image, 360°, point cloud)"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="v2" name="Write author comments and site notes; optional AI description and pins"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="v3" name="Tick flags: Safety / Quality / Schedule delay"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="v4" name="Optionally save as a draft and come back later"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_12</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="c1" name="Open side-by-side comparison; pick left and right files"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="c2" name="Capture snapshots; write notes for each side; tick per-side flags"><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="c3" name="Save this comparison as a draft"><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="more" name="Another comparison?"><bpmn:incoming>Flow_9</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing><bpmn:outgoing>Flow_11</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="c4" name="Pick the drafts to consolidate into one report"><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_13</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="j" name=""><bpmn:incoming>Flow_12</bpmn:incoming><bpmn:incoming>Flow_13</bpmn:incoming><bpmn:outgoing>Flow_14</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="pdf" name="Choose sections; generate the PDF in the browser (jsPDF; pdf-lib to merge)"><bpmn:incoming>Flow_14</bpmn:incoming><bpmn:outgoing>Flow_15</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="pub" name="Store PDF in MinIO; create report (visible only to its creator); delete source drafts"><bpmn:incoming>Flow_15</bpmn:incoming><bpmn:outgoing>Flow_16</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="e" name="Report published"><bpmn:incoming>Flow_16</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="Flow_1" sourceRef="s0" targetRef="t"/>
<bpmn:sequenceFlow id="Flow_2" name="Single file" sourceRef="t" targetRef="v1"/>
<bpmn:sequenceFlow id="Flow_3" name="Comparison" sourceRef="t" targetRef="c1"/>
<bpmn:sequenceFlow id="Flow_4" sourceRef="v1" targetRef="v2"/>
<bpmn:sequenceFlow id="Flow_5" sourceRef="v2" targetRef="v3"/>
<bpmn:sequenceFlow id="Flow_6" sourceRef="v3" targetRef="v4"/>
<bpmn:sequenceFlow id="Flow_7" sourceRef="c1" targetRef="c2"/>
<bpmn:sequenceFlow id="Flow_8" sourceRef="c2" targetRef="c3"/>
<bpmn:sequenceFlow id="Flow_9" sourceRef="c3" targetRef="more"/>
<bpmn:sequenceFlow id="Flow_10" name="Yes" sourceRef="more" targetRef="c1"/>
<bpmn:sequenceFlow id="Flow_11" name="No" sourceRef="more" targetRef="c4"/>
<bpmn:sequenceFlow id="Flow_12" sourceRef="v4" targetRef="j"/>
<bpmn:sequenceFlow id="Flow_13" sourceRef="c4" targetRef="j"/>
<bpmn:sequenceFlow id="Flow_14" sourceRef="j" targetRef="pdf"/>
<bpmn:sequenceFlow id="Flow_15" sourceRef="pdf" targetRef="pub"/>
<bpmn:sequenceFlow id="Flow_16" sourceRef="pub" targetRef="e"/>
</bpmn:process>

<bpmndi:BPMNShape id="view_di" bpmnElement="view"><dc:Bounds x="1767" y="100" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1725" y="142" width="120" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="fail_di" bpmnElement="fail"><dc:Bounds x="835" y="322" width="150" height="90"/></bpmndi:BPMNShape>

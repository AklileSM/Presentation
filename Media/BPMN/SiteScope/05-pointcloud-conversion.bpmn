<bpmndi:BPMNShape id="rm_di" bpmnElement="rm"><dc:Bounds x="1185" y="198" width="150" height="90"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="j_di" bpmnElement="j" isMarkerVisible="true"><dc:Bounds x="1410" y="92" width="50" height="50"/></bpmndi:BPMNShape>

<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_05" targetNamespace="https://sitescope.smart-crg.com/bpmn" exporter="SiteScope BPMN generator" exporterVersion="1.0">
<bpmn:collaboration id="Collab_05"><bpmn:participant id="Pool_05" name="05 · Converting a point cloud file" processRef="Process_05"/>
</bpmn:collaboration>
<bpmn:process id="Process_05" isExecutable="false">
<bpmn:laneSet id="LaneSet_05">
<bpmn:lane id="Lane_s" name="SiteScope backend (converter pool, 2 workers)"><bpmn:flowNodeRef>s0</bpmn:flowNodeRef><bpmn:flowNodeRef>wait</bpmn:flowNodeRef><bpmn:flowNodeRef>proc</bpmn:flowNodeRef><bpmn:flowNodeRef>ok</bpmn:flowNodeRef><bpmn:flowNodeRef>store</bpmn:flowNodeRef><bpmn:flowNodeRef>del</bpmn:flowNodeRef><bpmn:flowNodeRef>rm</bpmn:flowNodeRef><bpmn:flowNodeRef>j</bpmn:flowNodeRef><bpmn:flowNodeRef>ready</bpmn:flowNodeRef><bpmn:flowNodeRef>view</bpmn:flowNodeRef><bpmn:flowNodeRef>fail</bpmn:flowNodeRef><bpmn:flowNodeRef>again</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_u" name="User"><bpmn:flowNodeRef>show</bpmn:flowNodeRef><bpmn:flowNodeRef>retry</bpmn:flowNodeRef><bpmn:flowNodeRef>gone</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="s0" name="Point cloud queued (status Pending)"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
<bpmn:serviceTask id="wait" name="Wait for a free conversion slot"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:incoming>Flow_16</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="proc" name="Mark Processing; run PotreeConverter"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="ok" name="Converted without errors?"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="store" name="Store the Potree octree in MinIO"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="del" name="Delete original LAZ / LAS? (configurable)"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="rm" name="Remove the original file"><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="j" name=""><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:incoming>Flow_9</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="ready" name="Mark Ready"><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="view" name="Open in the 3D point cloud viewer"><bpmn:incoming>Flow_11</bpmn:incoming></bpmn:endEvent>
<bpmn:serviceTask id="fail" name="Record the error; mark Failed"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_12</bpmn:outgoing></bpmn:serviceTask>
<bpmn:userTask id="show" name="See “Conversion failed” in the explorer"><bpmn:incoming>Flow_12</bpmn:incoming><bpmn:outgoing>Flow_13</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="retry" name="Retry?"><bpmn:incoming>Flow_13</bpmn:incoming><bpmn:outgoing>Flow_14</bpmn:outgoing><bpmn:outgoing>Flow_15</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="again" name="Retry conversion: reset to Pending and resubmit"><bpmn:incoming>Flow_14</bpmn:incoming><bpmn:outgoing>Flow_16</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="gone" name="Re-upload the file instead"><bpmn:incoming>Flow_15</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="Flow_1" sourceRef="s0" targetRef="wait"/>
<bpmn:sequenceFlow id="Flow_2" sourceRef="wait" targetRef="proc"/>
<bpmn:sequenceFlow id="Flow_3" sourceRef="proc" targetRef="ok"/>
<bpmn:sequenceFlow id="Flow_4" name="Yes" sourceRef="ok" targetRef="store"/>
<bpmn:sequenceFlow id="Flow_5" name="No" sourceRef="ok" targetRef="fail"/>
<bpmn:sequenceFlow id="Flow_6" sourceRef="store" targetRef="del"/>
<bpmn:sequenceFlow id="Flow_7" name="Yes" sourceRef="del" targetRef="rm"/>
<bpmn:sequenceFlow id="Flow_8" name="No" sourceRef="del" targetRef="j"/>
<bpmn:sequenceFlow id="Flow_9" sourceRef="rm" targetRef="j"/>
<bpmn:sequenceFlow id="Flow_10" sourceRef="j" targetRef="ready"/>
<bpmn:sequenceFlow id="Flow_11" sourceRef="ready" targetRef="view"/>
<bpmn:sequenceFlow id="Flow_12" sourceRef="fail" targetRef="show"/>
<bpmn:sequenceFlow id="Flow_13" sourceRef="show" targetRef="retry"/>
<bpmn:sequenceFlow id="Flow_14" name="Yes" sourceRef="retry" targetRef="again"/>
<bpmn:sequenceFlow id="Flow_15" name="No" sourceRef="retry" targetRef="gone"/>
<bpmn:sequenceFlow id="Flow_16" sourceRef="again" targetRef="wait"/>
<bpmn:textAnnotation id="Note_1"><bpmn:text>On server restart, files left Uploading, Pending or Processing are marked Failed and can be retried.</bpmn:text></bpmn:textAnnotation>
</bpmn:process>
<bpmndi:BPMNDiagram id="Diagram_05"><bpmndi:BPMNPlane id="Plane_05" bpmnElement="Collab_05">

<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_12s" targetNamespace="https://sitescope.smart-crg.com/bpmn" exporter="SiteScope BPMN generator" exporterVersion="1.0">
<bpmn:collaboration id="Collab_12s"><bpmn:participant id="Pool_12s" name="SiteScope mission loop (summary of diagram 12)" processRef="Process_12s"/>
</bpmn:collaboration>
<bpmn:process id="Process_12s" isExecutable="false">
<bpmn:laneSet id="LaneSet_12s">
<bpmn:lane id="Lane_ag" name="Robot agent (Go2-W)"><bpmn:flowNodeRef>s</bpmn:flowNodeRef><bpmn:flowNodeRef>hc</bpmn:flowNodeRef><bpmn:flowNodeRef>bad</bpmn:flowNodeRef><bpmn:flowNodeRef>m</bpmn:flowNodeRef><bpmn:flowNodeRef>more</bpmn:flowNodeRef><bpmn:flowNodeRef>q</bpmn:flowNodeRef><bpmn:flowNodeRef>home</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_hw" name="Nav2 / Insta360 X4 / LiDAR"><bpmn:flowNodeRef>nav</bpmn:flowNodeRef><bpmn:flowNodeRef>cap</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_be" name="SiteScope backend"><bpmn:flowNodeRef>up</bpmn:flowNodeRef><bpmn:flowNodeRef>fin</bpmn:flowNodeRef><bpmn:flowNodeRef>e</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="s" name="Mission claimed"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
<bpmn:exclusiveGateway id="hc" name="Navigation healthy?"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="bad" name="Task failed"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:errorEventDefinition id="EED_bad"/></bpmn:endEvent>
<bpmn:exclusiveGateway id="m" name=""><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:incoming>Flow_9</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="more" name="Next capture point?"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="nav" name="Navigate to capture point (x, y, yaw)"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="cap" name="Capture 360° photo / LiDAR scan"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="q" name="Quality check; retake if needed"><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="up" name="Store with provenance; thumbnail, AI description"><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="home" name="Return to home pose"><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="fin" name="Close mission; post results"><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_12</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="e" name="Evidence available"><bpmn:incoming>Flow_12</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="Flow_1" sourceRef="s" targetRef="hc"/>
<bpmn:sequenceFlow id="Flow_2" name="No" sourceRef="hc" targetRef="bad"/>
<bpmn:sequenceFlow id="Flow_3" name="Yes" sourceRef="hc" targetRef="m"/>
<bpmn:sequenceFlow id="Flow_4" sourceRef="m" targetRef="more"/>
<bpmn:sequenceFlow id="Flow_5" name="Yes" sourceRef="more" targetRef="nav"/>
<bpmn:sequenceFlow id="Flow_6" sourceRef="nav" targetRef="cap"/>
<bpmn:sequenceFlow id="Flow_7" sourceRef="cap" targetRef="q"/>
<bpmn:sequenceFlow id="Flow_8" sourceRef="q" targetRef="up"/>
<bpmn:sequenceFlow id="Flow_9" sourceRef="up" targetRef="m"/>
<bpmn:sequenceFlow id="Flow_10" name="No" sourceRef="more" targetRef="home"/>
<bpmn:sequenceFlow id="Flow_11" sourceRef="home" targetRef="fin"/>
<bpmn:sequenceFlow id="Flow_12" sourceRef="fin" targetRef="e"/>
</bpmn:process>

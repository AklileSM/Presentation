<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_10" targetNamespace="https://sitescope.smart-crg.com/bpmn" exporter="SiteScope BPMN generator" exporterVersion="1.0">
<bpmn:collaboration id="Collab_10"><bpmn:participant id="Pool_10" name="10 · Robot onboarding, map and capture points (one-time setup)" processRef="Process_10"/>
</bpmn:collaboration>
<bpmn:process id="Process_10" isExecutable="false">
<bpmn:laneSet id="LaneSet_10">
<bpmn:lane id="Lane_own" name="Project owner / Admin (web app)"><bpmn:flowNodeRef>s</bpmn:flowNodeRef><bpmn:flowNodeRef>acct</bpmn:flowNodeRef><bpmn:flowNodeRef>tok</bpmn:flowNodeRef><bpmn:flowNodeRef>how</bpmn:flowNodeRef><bpmn:flowNodeRef>upl</bpmn:flowNodeRef><bpmn:flowNodeRef>park</bpmn:flowNodeRef><bpmn:flowNodeRef>drive</bpmn:flowNodeRef><bpmn:flowNodeRef>save</bpmn:flowNodeRef><bpmn:flowNodeRef>pts</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_be" name="SiteScope backend"><bpmn:flowNodeRef>grant</bpmn:flowNodeRef><bpmn:flowNodeRef>valid</bpmn:flowNodeRef><bpmn:flowNodeRef>rej</bpmn:flowNodeRef><bpmn:flowNodeRef>creds</bpmn:flowNodeRef><bpmn:flowNodeRef>online</bpmn:flowNodeRef><bpmn:flowNodeRef>qstart</bpmn:flowNodeRef><bpmn:flowNodeRef>qsave</bpmn:flowNodeRef><bpmn:flowNodeRef>store</bpmn:flowNodeRef><bpmn:flowNodeRef>savepts</bpmn:flowNodeRef><bpmn:flowNodeRef>ready</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_ag" name="Robot agent (Jetson Orin NX)"><bpmn:flowNodeRef>claim</bpmn:flowNodeRef><bpmn:flowNodeRef>cfg</bpmn:flowNodeRef><bpmn:flowNodeRef>hb</bpmn:flowNodeRef><bpmn:flowNodeRef>upmap</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_ros" name="Robot control panel / ROS 2"><bpmn:flowNodeRef>slam</bpmn:flowNodeRef><bpmn:flowNodeRef>saved</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="s" name="New robot to add"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
<bpmn:userTask id="acct" name="Create robot service account (Admin › Robot pairing)"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="tok" name="Create pairing token and choose the default project"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="grant" name="Give robot Editor role on the project; store one-time token with expiry"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:serviceTask>
<bpmn:manualTask id="claim" name="Claim the token once on the robot (robot_agent.py --claim-pairing-token)"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:manualTask>
<bpmn:exclusiveGateway id="valid" name="Token valid and unused?"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="rej" name="Claim rejected (unknown, revoked, expired or already claimed)"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:errorEventDefinition id="EED_rej"/></bpmn:endEvent>
<bpmn:serviceTask id="creds" name="Mark token claimed; return robot credentials and server URL"><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="cfg" name="Write robot_agent_config.json; start the sitescope-agent service"><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="hb" name="Log in; heartbeat with camera / LiDAR availability"><bpmn:incoming>Flow_9</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="online" name="Show robot online on the Robots page"><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="how" name="How will the map be provided?"><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_12</bpmn:outgoing><bpmn:outgoing>Flow_13</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="upl" name="Upload existing map files (.yaml + .pgm / .png)"><bpmn:incoming>Flow_12</bpmn:incoming><bpmn:outgoing>Flow_22</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="park" name="Park robot at its home pose; press Start mapping"><bpmn:incoming>Flow_13</bpmn:incoming><bpmn:outgoing>Flow_14</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="qstart" name="Queue map_start command"><bpmn:incoming>Flow_14</bpmn:incoming><bpmn:outgoing>Flow_15</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="slam" name="Check sensors, stop navigation, start SLAM, stream live map"><bpmn:incoming>Flow_15</bpmn:incoming><bpmn:outgoing>Flow_16</bpmn:outgoing></bpmn:serviceTask>
<bpmn:manualTask id="drive" name="Drive the site with the handheld controller; bring robot back home"><bpmn:incoming>Flow_16</bpmn:incoming><bpmn:outgoing>Flow_17</bpmn:outgoing></bpmn:manualTask>
<bpmn:userTask id="save" name="Name the map; press Save (enabled when back within 30 cm / 15°)"><bpmn:incoming>Flow_17</bpmn:incoming><bpmn:outgoing>Flow_18</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="qsave" name="Queue map_save command"><bpmn:incoming>Flow_18</bpmn:incoming><bpmn:outgoing>Flow_19</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="saved" name="Save map and home pose; switch localization to the new map; stop SLAM"><bpmn:incoming>Flow_19</bpmn:incoming><bpmn:outgoing>Flow_20</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="upmap" name="Upload the map to the project"><bpmn:incoming>Flow_20</bpmn:incoming><bpmn:outgoing>Flow_21</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="store" name="Store new map version; retire capture points placed on the old map"><bpmn:incoming>Flow_21</bpmn:incoming><bpmn:incoming>Flow_22</bpmn:incoming><bpmn:outgoing>Flow_23</bpmn:outgoing></bpmn:serviceTask>
<bpmn:userTask id="pts" name="Place capture points: map position, facing direction, room"><bpmn:incoming>Flow_23</bpmn:incoming><bpmn:outgoing>Flow_24</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="savepts" name="Save capture points in the map frame (x, y, yaw)"><bpmn:incoming>Flow_24</bpmn:incoming><bpmn:outgoing>Flow_25</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="ready" name="Robot ready for missions"><bpmn:incoming>Flow_25</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="Flow_1" sourceRef="s" targetRef="acct"/>
<bpmn:sequenceFlow id="Flow_2" sourceRef="acct" targetRef="tok"/>
<bpmn:sequenceFlow id="Flow_3" sourceRef="tok" targetRef="grant"/>
<bpmn:sequenceFlow id="Flow_4" sourceRef="grant" targetRef="claim"/>
<bpmn:sequenceFlow id="Flow_5" sourceRef="claim" targetRef="valid"/>
<bpmn:sequenceFlow id="Flow_6" name="No" sourceRef="valid" targetRef="rej"/>
<bpmn:sequenceFlow id="Flow_7" name="Yes" sourceRef="valid" targetRef="creds"/>
<bpmn:sequenceFlow id="Flow_8" sourceRef="creds" targetRef="cfg"/>
<bpmn:sequenceFlow id="Flow_9" sourceRef="cfg" targetRef="hb"/>
<bpmn:sequenceFlow id="Flow_10" sourceRef="hb" targetRef="online"/>
<bpmn:sequenceFlow id="Flow_11" sourceRef="online" targetRef="how"/>
<bpmn:sequenceFlow id="Flow_12" name="Upload" sourceRef="how" targetRef="upl"/>
<bpmn:sequenceFlow id="Flow_13" name="Record" sourceRef="how" targetRef="park"/>
<bpmn:sequenceFlow id="Flow_14" sourceRef="park" targetRef="qstart"/>
<bpmn:sequenceFlow id="Flow_15" sourceRef="qstart" targetRef="slam"/>
<bpmn:sequenceFlow id="Flow_16" sourceRef="slam" targetRef="drive"/>
<bpmn:sequenceFlow id="Flow_17" sourceRef="drive" targetRef="save"/>
<bpmn:sequenceFlow id="Flow_18" sourceRef="save" targetRef="qsave"/>
<bpmn:sequenceFlow id="Flow_19" sourceRef="qsave" targetRef="saved"/>
<bpmn:sequenceFlow id="Flow_20" sourceRef="saved" targetRef="upmap"/>
<bpmn:sequenceFlow id="Flow_21" sourceRef="upmap" targetRef="store"/>
<bpmn:sequenceFlow id="Flow_22" sourceRef="upl" targetRef="store"/>
<bpmn:sequenceFlow id="Flow_23" sourceRef="store" targetRef="pts"/>
<bpmn:sequenceFlow id="Flow_24" sourceRef="pts" targetRef="savepts"/>
<bpmn:sequenceFlow id="Flow_25" sourceRef="savepts" targetRef="ready"/>
<bpmn:textAnnotation id="Note_1"><bpmn:text>Robot accounts are non-admin service users. Missions can only upload to projects where the robot is Owner or Editor.</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="Assoc_1" sourceRef="tok" targetRef="Note_1"/>
<bpmn:textAnnotation id="Note_2"><bpmn:text>“Switch back to the previous map” restores the old map, home pose and its capture points.</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="Assoc_2" sourceRef="store" targetRef="Note_2"/>
<bpmn:textAnnotation id="Note_3"><bpmn:text>The agent claims commands by polling, the same way it claims missions.</bpmn:text></bpmn:textAnnotation>
</bpmn:process>
<bpmndi:BPMNDiagram id="Diagram_10"><bpmndi:BPMNPlane id="Plane_10" bpmnElement="Collab_10">

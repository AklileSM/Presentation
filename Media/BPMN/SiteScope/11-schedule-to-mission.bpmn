<bpmndi:BPMNShape id="busy_di" bpmnElement="busy" isMarkerVisible="true"><dc:Bounds x="1235" y="288" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="1200" y="254" width="120" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>

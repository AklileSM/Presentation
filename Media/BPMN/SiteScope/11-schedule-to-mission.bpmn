<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_11" targetNamespace="https://sitescope.smart-crg.com/bpmn" exporter="SiteScope BPMN generator" exporterVersion="1.0">
<bpmn:collaboration id="Collab_11"><bpmn:participant id="Pool_11" name="11 · Scheduled inspection: from recurring schedule to mission" processRef="Process_11"/>
</bpmn:collaboration>
<bpmn:process id="Process_11" isExecutable="false">
<bpmn:laneSet id="LaneSet_11">
<bpmn:lane id="Lane_own" name="Project owner / Editor (Schedules tab or voice assistant)"><bpmn:flowNodeRef>s</bpmn:flowNodeRef><bpmn:flowNodeRef>create</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_be" name="SiteScope backend: schedule dispatcher (every 15 s)"><bpmn:flowNodeRef>next</bpmn:flowNodeRef><bpmn:flowNodeRef>due</bpmn:flowNodeRef><bpmn:flowNodeRef>late</bpmn:flowNodeRef><bpmn:flowNodeRef>missed</bpmn:flowNodeRef><bpmn:flowNodeRef>ok</bpmn:flowNodeRef><bpmn:flowNodeRef>dis</bpmn:flowNodeRef><bpmn:flowNodeRef>inv</bpmn:flowNodeRef><bpmn:flowNodeRef>busy</bpmn:flowNodeRef><bpmn:flowNodeRef>skipb</bpmn:flowNodeRef><bpmn:flowNodeRef>pay</bpmn:flowNodeRef><bpmn:flowNodeRef>skipp</bpmn:flowNodeRef><bpmn:flowNodeRef>mk</bpmn:flowNodeRef><bpmn:flowNodeRef>conn</bpmn:flowNodeRef><bpmn:flowNodeRef>qc</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_ag" name="Robot agent"><bpmn:flowNodeRef>claim</bpmn:flowNodeRef><bpmn:flowNodeRef>run</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="s" name="Inspection to repeat"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
<bpmn:userTask id="create" name="Create schedule: robot, ordered capture points, time + time zone, weekdays, photo / 3D scan, if busy: skip"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="next" name="Validate; compute next run in the schedule's time zone"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:serviceTask>
<bpmn:intermediateCatchEvent id="due" name="Next run time reached"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing><bpmn:timerEventDefinition id="TED_due"/></bpmn:intermediateCatchEvent>
<bpmn:exclusiveGateway id="late" name="More than 30 min late?"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="missed" name="Occurrence missed"><bpmn:incoming>Flow_5</bpmn:incoming></bpmn:endEvent>
<bpmn:exclusiveGateway id="ok" name="Robot still Editor and capture points on the current map?"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing><bpmn:outgoing>Flow_9</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="dis" name="Disable schedule and record the reason"><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="inv" name="Schedule invalid"><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:errorEventDefinition id="EED_inv"/></bpmn:endEvent>
<bpmn:exclusiveGateway id="busy" name="Robot busy with another task?"><bpmn:incoming>Flow_9</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing><bpmn:outgoing>Flow_11</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="skipb" name="Skipped: robot busy"><bpmn:incoming>Flow_10</bpmn:incoming></bpmn:endEvent>
<bpmn:exclusiveGateway id="pay" name="Camera / LiDAR available on the robot?"><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_12</bpmn:outgoing><bpmn:outgoing>Flow_13</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="skipp" name="Skipped: payload unavailable"><bpmn:incoming>Flow_12</bpmn:incoming></bpmn:endEvent>
<bpmn:serviceTask id="mk" name="Create mission with one step per capture point (queued)"><bpmn:incoming>Flow_13</bpmn:incoming><bpmn:outgoing>Flow_14</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="conn" name="Auto-connect on and robot not connected?"><bpmn:incoming>Flow_14</bpmn:incoming><bpmn:outgoing>Flow_15</bpmn:outgoing><bpmn:outgoing>Flow_16</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="qc" name="Queue Connect robot command"><bpmn:incoming>Flow_15</bpmn:incoming><bpmn:outgoing>Flow_17</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="claim" name="Agent poll: run Connect first, then claim the oldest queued mission"><bpmn:incoming>Flow_16</bpmn:incoming><bpmn:incoming>Flow_17</bpmn:incoming><bpmn:outgoing>Flow_18</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="run" name="Mission runs (diagram 12)"><bpmn:incoming>Flow_18</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="Flow_1" sourceRef="s" targetRef="create"/>
<bpmn:sequenceFlow id="Flow_2" sourceRef="create" targetRef="next"/>
<bpmn:sequenceFlow id="Flow_3" sourceRef="next" targetRef="due"/>
<bpmn:sequenceFlow id="Flow_4" sourceRef="due" targetRef="late"/>
<bpmn:sequenceFlow id="Flow_5" name="Yes" sourceRef="late" targetRef="missed"/>
<bpmn:sequenceFlow id="Flow_6" name="No" sourceRef="late" targetRef="ok"/>
<bpmn:sequenceFlow id="Flow_7" name="No" sourceRef="ok" targetRef="dis"/>
<bpmn:sequenceFlow id="Flow_8" sourceRef="dis" targetRef="inv"/>
<bpmn:sequenceFlow id="Flow_9" name="Yes" sourceRef="ok" targetRef="busy"/>
<bpmn:sequenceFlow id="Flow_10" name="Yes" sourceRef="busy" targetRef="skipb"/>
<bpmn:sequenceFlow id="Flow_11" name="No" sourceRef="busy" targetRef="pay"/>
<bpmn:sequenceFlow id="Flow_12" name="No" sourceRef="pay" targetRef="skipp"/>
<bpmn:sequenceFlow id="Flow_13" name="Yes" sourceRef="pay" targetRef="mk"/>
<bpmn:sequenceFlow id="Flow_14" sourceRef="mk" targetRef="conn"/>
<bpmn:sequenceFlow id="Flow_15" name="Yes" sourceRef="conn" targetRef="qc"/>
<bpmn:sequenceFlow id="Flow_16" name="No" sourceRef="conn" targetRef="claim"/>
<bpmn:sequenceFlow id="Flow_17" sourceRef="qc" targetRef="claim"/>
<bpmn:sequenceFlow id="Flow_18" sourceRef="claim" targetRef="run"/>
<bpmn:textAnnotation id="Note_1"><bpmn:text>Each occurrence creates at most one mission. After every occurrence the next run is computed, so the schedule keeps firing until it is disabled.</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="Assoc_1" sourceRef="due" targetRef="Note_1"/>
<bpmn:textAnnotation id="Note_2"><bpmn:text>A one-off trip (“Run now” on the Route tab) creates the same queued mission directly, after the same robot, map and payload checks.</bpmn:text></bpmn:textAnnotation>
</bpmn:process>

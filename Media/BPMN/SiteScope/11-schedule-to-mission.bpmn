<bpmndi:BPMNShape id="Lane_ag_di" bpmnElement="Lane_ag" isHorizontal="true"><dc:Bounds x="50" y="660" width="2338" height="195"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="s_di" bpmnElement="s"><dc:Bounds x="192" y="100" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="150" y="142" width="120" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>

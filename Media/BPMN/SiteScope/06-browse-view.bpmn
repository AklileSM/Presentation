<bpmn:laneSet id="LaneSet_06">
<bpmn:lane id="Lane_u" name="Project member"><bpmn:flowNodeRef>s0</bpmn:flowNodeRef><bpmn:flowNodeRef>how</bpmn:flowNodeRef><bpmn:flowNodeRef>j</bpmn:flowNodeRef><bpmn:flowNodeRef>date</bpmn:flowNodeRef><bpmn:flowNodeRef>room</bpmn:flowNodeRef><bpmn:flowNodeRef>srch</bpmn:flowNodeRef><bpmn:flowNodeRef>mine</bpmn:flowNodeRef><bpmn:flowNodeRef>pick</bpmn:flowNodeRef><bpmn:flowNodeRef>act</bpmn:flowNodeRef><bpmn:flowNodeRef>vj</bpmn:flowNodeRef><bpmn:flowNodeRef>img</bpmn:flowNodeRef><bpmn:flowNodeRef>pano</bpmn:flowNodeRef><bpmn:flowNodeRef>pcv</bpmn:flowNodeRef><bpmn:flowNodeRef>pdf</bpmn:flowNodeRef><bpmn:flowNodeRef>cmp</bpmn:flowNodeRef><bpmn:flowNodeRef>bulk</bpmn:flowNodeRef><bpmn:flowNodeRef>csv</bpmn:flowNodeRef><bpmn:flowNodeRef>more</bpmn:flowNodeRef><bpmn:flowNodeRef>done</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="s0" name="Open a project"><bpmn:outgoing>Flow_23</bpmn:outgoing></bpmn:startEvent>
<bpmn:exclusiveGateway id="how" name="How to find files?"><bpmn:incoming>Flow_23</bpmn:incoming><bpmn:outgoing>Flow_1</bpmn:outgoing><bpmn:outgoing>Flow_3</bpmn:outgoing><bpmn:outgoing>Flow_5</bpmn:outgoing><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="j" name=""><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:outgoing>Flow_24</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="date" name="Date browser: pick a capture date, files grouped by room"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="room" name="Room: pick from floor plan or list, files grouped by date"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="srch" name="Search filename, room or date (top 20 fuzzy matches)"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="mine" name="My uploads (profile page)"><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="pick" name="Select files"><bpmn:incoming>Flow_24</bpmn:incoming><bpmn:incoming>Flow_28</bpmn:incoming><bpmn:outgoing>Flow_25</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="act" name="What next?"><bpmn:incoming>Flow_25</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing><bpmn:outgoing>Flow_11</bpmn:outgoing><bpmn:outgoing>Flow_13</bpmn:outgoing><bpmn:outgoing>Flow_15</bpmn:outgoing><bpmn:outgoing>Flow_17</bpmn:outgoing><bpmn:outgoing>Flow_19</bpmn:outgoing><bpmn:outgoing>Flow_20</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="vj" name=""><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:incoming>Flow_12</bpmn:incoming><bpmn:incoming>Flow_14</bpmn:incoming><bpmn:incoming>Flow_16</bpmn:incoming><bpmn:incoming>Flow_18</bpmn:incoming><bpmn:incoming>Flow_21</bpmn:incoming><bpmn:incoming>Flow_22</bpmn:incoming><bpmn:outgoing>Flow_26</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="img" name="Image viewer (zoom, AI description, annotations)"><bpmn:incoming>Flow_9</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="pano" name="360° panorama viewer"><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_12</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="pcv" name="3D point cloud viewer (once Ready)"><bpmn:incoming>Flow_13</bpmn:incoming><bpmn:outgoing>Flow_14</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="pdf" name="PDF viewer"><bpmn:incoming>Flow_15</bpmn:incoming><bpmn:outgoing>Flow_16</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="cmp" name="Compare two captures side by side, views locked together"><bpmn:incoming>Flow_17</bpmn:incoming><bpmn:outgoing>Flow_18</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="bulk" name="Bulk download (ZIP) or delete (Owner / Editor)"><bpmn:incoming>Flow_19</bpmn:incoming><bpmn:outgoing>Flow_21</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="csv" name="Export robot capture-quality or mission-outcome CSV"><bpmn:incoming>Flow_20</bpmn:incoming><bpmn:outgoing>Flow_22</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="more" name="Anything else?"><bpmn:incoming>Flow_26</bpmn:incoming><bpmn:outgoing>Flow_27</bpmn:outgoing><bpmn:outgoing>Flow_28</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="done" name="Done browsing"><bpmn:incoming>Flow_27</bpmn:incoming></bpmn:endEvent>

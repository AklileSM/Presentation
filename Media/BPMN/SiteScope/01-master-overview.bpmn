<bpmn:laneSet id="LaneSet_01">
<bpmn:lane id="Lane_g" name="Guest (not logged in)"><bpmn:flowNodeRef>gs</bpmn:flowNodeRef><bpmn:flowNodeRef>gauth</bpmn:flowNodeRef><bpmn:flowNodeRef>ge</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_u" name="Logged-in user (all roles)"><bpmn:flowNodeRef>us</bpmn:flowNodeRef><bpmn:flowNodeRef>um</bpmn:flowNodeRef><bpmn:flowNodeRef>uw</bpmn:flowNodeRef><bpmn:flowNodeRef>uj</bpmn:flowNodeRef><bpmn:flowNodeRef>again</bpmn:flowNodeRef><bpmn:flowNodeRef>ue</bpmn:flowNodeRef><bpmn:flowNodeRef>up</bpmn:flowNodeRef><bpmn:flowNodeRef>br</bpmn:flowNodeRef><bpmn:flowNodeRef>an</bpmn:flowNodeRef><bpmn:flowNodeRef>rep</bpmn:flowNodeRef><bpmn:flowNodeRef>me</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_o" name="Project owner"><bpmn:flowNodeRef>os</bpmn:flowNodeRef><bpmn:flowNodeRef>ow</bpmn:flowNodeRef><bpmn:flowNodeRef>op</bpmn:flowNodeRef><bpmn:flowNodeRef>orb</bpmn:flowNodeRef><bpmn:flowNodeRef>osc</bpmn:flowNodeRef><bpmn:flowNodeRef>oj</bpmn:flowNodeRef><bpmn:flowNodeRef>oe</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_r" name="Robot (Go2-W) and agent"><bpmn:flowNodeRef>rs</bpmn:flowNodeRef><bpmn:flowNodeRef>rm</bpmn:flowNodeRef><bpmn:flowNodeRef>re</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_sys" name="System (automatic)"><bpmn:flowNodeRef>s1</bpmn:flowNodeRef><bpmn:flowNodeRef>pc</bpmn:flowNodeRef><bpmn:flowNodeRef>s1e</bpmn:flowNodeRef><bpmn:flowNodeRef>s2</bpmn:flowNodeRef><bpmn:flowNodeRef>ai</bpmn:flowNodeRef><bpmn:flowNodeRef>s2e</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_a" name="Administrator"><bpmn:flowNodeRef>as</bpmn:flowNodeRef><bpmn:flowNodeRef>adm</bpmn:flowNodeRef><bpmn:flowNodeRef>ae</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="gs" name="Visitor arrives"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
<bpmn:task id="gauth" name="Register, log in or reset password → 02"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:task>
<bpmn:endEvent id="ge" name="Logged in"><bpmn:incoming>Flow_2</bpmn:incoming></bpmn:endEvent>
<bpmn:startEvent id="us" name="Session starts"><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:startEvent>
<bpmn:exclusiveGateway id="um" name=""><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:incoming>Flow_17</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="uw" name="What would you like to do?"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing><bpmn:outgoing>Flow_7</bpmn:outgoing><bpmn:outgoing>Flow_9</bpmn:outgoing><bpmn:outgoing>Flow_11</bpmn:outgoing><bpmn:outgoing>Flow_13</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="uj" name=""><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:incoming>Flow_12</bpmn:incoming><bpmn:incoming>Flow_14</bpmn:incoming><bpmn:outgoing>Flow_15</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="again" name="Something else?"><bpmn:incoming>Flow_15</bpmn:incoming><bpmn:outgoing>Flow_16</bpmn:outgoing><bpmn:outgoing>Flow_17</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="ue" name="Session ends"><bpmn:incoming>Flow_16</bpmn:incoming></bpmn:endEvent>
<bpmn:task id="up" name="Upload photos, 360°, video, PDFs, point clouds → 04"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:task>
<bpmn:task id="br" name="Browse, search, view and compare media → 06"><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:task>
<bpmn:task id="an" name="Pin annotations on images → 08"><bpmn:incoming>Flow_9</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:task>
<bpmn:task id="rep" name="Write and publish a PDF field report → 09"><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_12</bpmn:outgoing></bpmn:task>
<bpmn:task id="me" name="Review own uploads, drafts, reports and activity"><bpmn:incoming>Flow_13</bpmn:incoming><bpmn:outgoing>Flow_14</bpmn:outgoing></bpmn:task>
<bpmn:startEvent id="os" name="New project or site"><bpmn:outgoing>Flow_18</bpmn:outgoing></bpmn:startEvent>
<bpmn:exclusiveGateway id="ow" name=""><bpmn:incoming>Flow_18</bpmn:incoming><bpmn:outgoing>Flow_19</bpmn:outgoing><bpmn:outgoing>Flow_20</bpmn:outgoing><bpmn:outgoing>Flow_21</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="op" name="Create project: details, rooms, floor plan, room pins; invite members → 03"><bpmn:incoming>Flow_19</bpmn:incoming><bpmn:outgoing>Flow_22</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="orb" name="Pair a robot, record the map, place capture points → 10"><bpmn:incoming>Flow_20</bpmn:incoming><bpmn:outgoing>Flow_23</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="osc" name="Schedule recurring inspections (Schedules tab or voice assistant) → 11, 13"><bpmn:incoming>Flow_21</bpmn:incoming><bpmn:outgoing>Flow_24</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="oj" name=""><bpmn:incoming>Flow_22</bpmn:incoming><bpmn:incoming>Flow_23</bpmn:incoming><bpmn:incoming>Flow_24</bpmn:incoming><bpmn:outgoing>Flow_25</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="oe" name="Project ready"><bpmn:incoming>Flow_25</bpmn:incoming></bpmn:endEvent>
<bpmn:startEvent id="rs" name="Scheduled run is due"><bpmn:outgoing>Flow_26</bpmn:outgoing><bpmn:timerEventDefinition id="TED_rs"/></bpmn:startEvent>
<bpmn:serviceTask id="rm" name="Navigate to each capture point, capture, upload, return home → 12"><bpmn:incoming>Flow_26</bpmn:incoming><bpmn:outgoing>Flow_27</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="re" name="Evidence stored with provenance"><bpmn:incoming>Flow_27</bpmn:incoming></bpmn:endEvent>
<bpmn:startEvent id="s1" name="Point cloud uploaded"><bpmn:outgoing>Flow_28</bpmn:outgoing><bpmn:messageEventDefinition id="MED_s1"/></bpmn:startEvent>
<bpmn:serviceTask id="pc" name="Convert LAZ / LAS to Potree 3D viewer → 05"><bpmn:incoming>Flow_28</bpmn:incoming><bpmn:outgoing>Flow_29</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="s1e" name="3D viewer ready"><bpmn:incoming>Flow_29</bpmn:incoming></bpmn:endEvent>
<bpmn:startEvent id="s2" name="Image uploaded"><bpmn:outgoing>Flow_30</bpmn:outgoing><bpmn:messageEventDefinition id="MED_s2"/></bpmn:startEvent>
<bpmn:serviceTask id="ai" name="Generate AI description: scene, quality, safety → 07"><bpmn:incoming>Flow_30</bpmn:incoming><bpmn:outgoing>Flow_31</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="s2e" name="Description available"><bpmn:incoming>Flow_31</bpmn:incoming></bpmn:endEvent>
<bpmn:startEvent id="as" name="Admin logs in"><bpmn:outgoing>Flow_32</bpmn:outgoing></bpmn:startEvent>
<bpmn:userTask id="adm" name="Manage users, robot accounts, projects and roles"><bpmn:incoming>Flow_32</bpmn:incoming><bpmn:outgoing>Flow_33</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="ae" name="Done"><bpmn:incoming>Flow_33</bpmn:incoming></bpmn:endEvent>

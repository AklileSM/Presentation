<bpmn:textAnnotation id="Note_1"><bpmn:text>Robot captures enter through the same upload pipeline as people's uploads, so AI analysis and point cloud conversion start automatically.</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="Assoc_1" sourceRef="re" targetRef="Note_1"/>
<bpmn:textAnnotation id="Note_2"><bpmn:text>The first registered user becomes the global administrator.</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="Assoc_2" sourceRef="adm" targetRef="Note_2"/>
</bpmn:process>
